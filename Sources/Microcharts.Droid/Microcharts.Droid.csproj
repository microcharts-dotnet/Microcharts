<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Microcharts.Droid</RootNamespace>
    <AssemblyName>Microcharts.Droid</AssemblyName>
    <Description>Simple, cross-platform chart library for dotnet Android.</Description>
    <PackageTags>maui anroid chart skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views" Version="$(SkiaSharpVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Microcharts/Microcharts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
    </ItemGroup>
</Project>